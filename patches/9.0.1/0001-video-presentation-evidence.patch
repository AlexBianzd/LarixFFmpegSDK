diff --git a/libavutil/larix_video_presentation.c b/libavutil/larix_video_presentation.c
new file mode 100644
index 0000000000000000000000000000000000000000..bf860b7824eb646d46cf7a12c935ed36d98d9179
--- /dev/null
+++ b/libavutil/larix_video_presentation.c
@@ -0,0 +1,224 @@
+/*
+ * Larix SDK video presentation evidence transport.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <errno.h>
+#include <string.h>
+
+#include "error.h"
+#include "frame.h"
+#include "larix_video_presentation.h"
+
+#define LARIX_PRESENTATION_V1_SIZE 112U
+#define LARIX_QUALIFIERS_MASK      ((1U << 3) - 1)
+#define LARIX_FFV1_PRESENT_MASK    ((1U << 4) - 1)
+#define LARIX_MPEG4_PRESENT_MASK   ((1U << 19) - 1)
+
+static int words_are_zero(const uint32_t *words, size_t count)
+{
+    for (size_t i = 0; i < count; ++i)
+        if (words[i])
+            return 0;
+    return 1;
+}
+
+static int absent_words_are_zero(uint32_t present,
+                                 const uint32_t *words, size_t count)
+{
+    for (size_t i = 0; i < count; ++i)
+        if (!(present & (1U << i)) && words[i])
+            return 0;
+    return 1;
+}
+
+static int validate_ffv1(const AVLarixVideoPresentationV1 *record)
+{
+    const AVLarixFFV1PresentationV1 *facts = &record->facts.ffv1;
+    uint32_t words[4];
+
+    memcpy(words, &facts->version, sizeof(words));
+    if (facts->present & ~LARIX_FFV1_PRESENT_MASK ||
+        !absent_words_are_zero(facts->present, words, 4) ||
+        !words_are_zero(facts->reserved, 3) ||
+        !words_are_zero(record->facts.storage + 8, 16))
+        return AVERROR_INVALIDDATA;
+
+    if ((facts->present & AV_LARIX_FFV1_PRESENT_SUPPLIED_FIELD_ORDER) &&
+        facts->supplied_field_order > AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_BT)
+        return AVERROR_INVALIDDATA;
+
+    if (facts->present & (AV_LARIX_FFV1_PRESENT_MICRO_VERSION |
+                          AV_LARIX_FFV1_PRESENT_PICTURE_STRUCTURE)) {
+        if (!(facts->present & AV_LARIX_FFV1_PRESENT_VERSION) ||
+            facts->version <= 2)
+            return AVERROR_INVALIDDATA;
+    }
+
+    return 0;
+}
+
+static int value_is_boolean(uint32_t present, uint32_t bit, uint32_t value)
+{
+    return !(present & bit) || value <= 1;
+}
+
+static int validate_mpeg4(const AVLarixVideoPresentationV1 *record)
+{
+    const AVLarixMPEG4PresentationV1 *facts = &record->facts.mpeg4;
+    uint32_t words[19];
+    const uint32_t ordinary_forbidden =
+        AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_SEQUENCE |
+        AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_FRAME |
+        AV_LARIX_MPEG4_PRESENT_REPEAT_FIRST_FIELD |
+        AV_LARIX_MPEG4_PRESENT_VOP_STRUCTURE |
+        AV_LARIX_MPEG4_PRESENT_STUDIO_FRAME_RATE_CODE |
+        AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_HIGH |
+        AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_LOW |
+        AV_LARIX_MPEG4_PRESENT_STUDIO_TEMPORAL_REFERENCE;
+    const uint32_t studio_forbidden =
+        AV_LARIX_MPEG4_PRESENT_VOL_INTERLACED |
+        AV_LARIX_MPEG4_PRESENT_TIME_INCREMENT_RESOLUTION |
+        AV_LARIX_MPEG4_PRESENT_FIXED_VOP_RATE |
+        AV_LARIX_MPEG4_PRESENT_FIXED_VOP_TIME_INCREMENT |
+        AV_LARIX_MPEG4_PRESENT_MODULO_TIME_BASE |
+        AV_LARIX_MPEG4_PRESENT_VOP_TIME_INCREMENT;
+
+    memcpy(words, &facts->vos_profile, sizeof(words));
+    if (facts->present & ~LARIX_MPEG4_PRESENT_MASK ||
+        !absent_words_are_zero(facts->present, words, 19) ||
+        !words_are_zero(facts->reserved, 3))
+        return AVERROR_INVALIDDATA;
+
+    if (facts->path == AV_LARIX_MPEG4_PATH_ORDINARY) {
+        if (facts->present & ordinary_forbidden)
+            return AVERROR_INVALIDDATA;
+    } else if (facts->path == AV_LARIX_MPEG4_PATH_STUDIO) {
+        if (facts->present & studio_forbidden)
+            return AVERROR_INVALIDDATA;
+    } else {
+        return AVERROR_INVALIDDATA;
+    }
+
+    if (!!(facts->present & AV_LARIX_MPEG4_PRESENT_VOS_PROFILE) !=
+        !!(facts->present & AV_LARIX_MPEG4_PRESENT_VOS_LEVEL))
+        return AVERROR_INVALIDDATA;
+    if (!!(facts->present & AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_HIGH) !=
+        !!(facts->present & AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_LOW))
+        return AVERROR_INVALIDDATA;
+
+    if (!value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_VOL_INTERLACED,
+                          facts->vol_interlaced) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_SEQUENCE,
+                          facts->studio_progressive_sequence) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_FRAME,
+                          facts->studio_progressive_frame) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_TOP_FIELD_FIRST,
+                          facts->top_field_first) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_REPEAT_FIRST_FIELD,
+                          facts->repeat_first_field) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_VOP_CODED,
+                          facts->vop_coded) ||
+        !value_is_boolean(facts->present,
+                          AV_LARIX_MPEG4_PRESENT_FIXED_VOP_RATE,
+                          facts->fixed_vop_rate))
+        return AVERROR_INVALIDDATA;
+
+    if (((facts->present & AV_LARIX_MPEG4_PRESENT_VOL_OBJECT_TYPE) &&
+         facts->vol_object_type > 255) ||
+        ((facts->present & AV_LARIX_MPEG4_PRESENT_VOP_STRUCTURE) &&
+         facts->vop_structure > 3) ||
+        ((facts->present & AV_LARIX_MPEG4_PRESENT_TIME_INCREMENT_RESOLUTION) &&
+         facts->time_increment_resolution > 65535) ||
+        ((facts->present & AV_LARIX_MPEG4_PRESENT_STUDIO_FRAME_RATE_CODE) &&
+         facts->studio_frame_rate_code > 15) ||
+        ((facts->present & AV_LARIX_MPEG4_PRESENT_STUDIO_TEMPORAL_REFERENCE) &&
+         facts->studio_temporal_reference > 1023))
+        return AVERROR_INVALIDDATA;
+
+    if (facts->present & AV_LARIX_MPEG4_PRESENT_FIXED_VOP_TIME_INCREMENT) {
+        if (!(facts->present & AV_LARIX_MPEG4_PRESENT_FIXED_VOP_RATE) ||
+            facts->fixed_vop_rate != 1 ||
+            !(facts->present & AV_LARIX_MPEG4_PRESENT_TIME_INCREMENT_RESOLUTION))
+            return AVERROR_INVALIDDATA;
+    }
+
+    if (facts->path == AV_LARIX_MPEG4_PATH_ORDINARY &&
+        (facts->present & AV_LARIX_MPEG4_PRESENT_TOP_FIELD_FIRST)) {
+        if (!(facts->present & AV_LARIX_MPEG4_PRESENT_VOL_INTERLACED) ||
+            facts->vol_interlaced != 1 ||
+            !(facts->present & AV_LARIX_MPEG4_PRESENT_VOP_CODED) ||
+            facts->vop_coded != 1)
+            return AVERROR_INVALIDDATA;
+    }
+
+    if (facts->path == AV_LARIX_MPEG4_PATH_STUDIO &&
+        (facts->present & (AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_FRAME |
+                           AV_LARIX_MPEG4_PRESENT_TOP_FIELD_FIRST |
+                           AV_LARIX_MPEG4_PRESENT_REPEAT_FIRST_FIELD))) {
+        if (!(facts->present & AV_LARIX_MPEG4_PRESENT_VOP_CODED) ||
+            facts->vop_coded != 1)
+            return AVERROR_INVALIDDATA;
+    }
+
+    return 0;
+}
+
+int av_larix_video_presentation_read_v1(
+    const AVFrame *frame,
+    AVLarixVideoPresentationV1 *output,
+    size_t output_size)
+{
+    const AVFrameSideData *found = NULL;
+    AVLarixVideoPresentationV1 candidate;
+    int ret;
+
+    if (!frame || !output || output_size != sizeof(*output))
+        return AVERROR(EINVAL);
+
+    for (int i = 0; i < frame->nb_side_data; ++i) {
+        const AVFrameSideData *side_data = frame->side_data[i];
+        if (side_data->type != AV_FRAME_DATA_LARIX_VIDEO_PRESENTATION)
+            continue;
+        if (found)
+            return AVERROR_INVALIDDATA;
+        found = side_data;
+    }
+
+    if (!found)
+        return AVERROR(ENOENT);
+    if (found->size != sizeof(candidate))
+        return AVERROR_INVALIDDATA;
+
+    memcpy(&candidate, found->data, sizeof(candidate));
+    if (candidate.version != AV_LARIX_VIDEO_PRESENTATION_VERSION_1)
+        return AVERROR(ENOSYS);
+    if (candidate.byte_size != LARIX_PRESENTATION_V1_SIZE)
+        return AVERROR_INVALIDDATA;
+    if (candidate.qualifiers & ~LARIX_QUALIFIERS_MASK)
+        return AVERROR_INVALIDDATA;
+
+    if (candidate.syntax == AV_LARIX_VIDEO_PRESENTATION_SYNTAX_FFV1)
+        ret = validate_ffv1(&candidate);
+    else if (candidate.syntax == AV_LARIX_VIDEO_PRESENTATION_SYNTAX_MPEG4)
+        ret = validate_mpeg4(&candidate);
+    else
+        return AVERROR(ENOSYS);
+    if (ret < 0)
+        return ret;
+
+    memcpy(output, &candidate, sizeof(candidate));
+    return 0;
+}
diff --git a/libavutil/larix_video_presentation.h b/libavutil/larix_video_presentation.h
new file mode 100644
index 0000000000000000000000000000000000000000..f43785fa4933e5c15463ca89e129912b2ad9ec30
--- /dev/null
+++ b/libavutil/larix_video_presentation.h
@@ -0,0 +1,143 @@
+/*
+ * Larix SDK video presentation evidence transport.
+ *
+ * This file is part of FFmpeg.
+ *
+ * FFmpeg is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#ifndef AVUTIL_LARIX_VIDEO_PRESENTATION_H
+#define AVUTIL_LARIX_VIDEO_PRESENTATION_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "frame.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+enum AVLarixVideoPresentationVersion {
+    AV_LARIX_VIDEO_PRESENTATION_VERSION_1 = 1,
+};
+
+enum AVLarixVideoPresentationSyntax {
+    AV_LARIX_VIDEO_PRESENTATION_SYNTAX_FFV1  = 1,
+    AV_LARIX_VIDEO_PRESENTATION_SYNTAX_MPEG4 = 2,
+};
+
+enum AVLarixVideoPresentationQualifier {
+    AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_RECOVERED_SYNTAX  = 1 << 0,
+    AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_INCOMPLETE_SYNTAX = 1 << 1,
+    AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_REEXPOSED_PICTURE = 1 << 2,
+};
+
+enum AVLarixFFV1PresentationPresent {
+    AV_LARIX_FFV1_PRESENT_VERSION              = 1 << 0,
+    AV_LARIX_FFV1_PRESENT_MICRO_VERSION        = 1 << 1,
+    AV_LARIX_FFV1_PRESENT_SUPPLIED_FIELD_ORDER = 1 << 2,
+    AV_LARIX_FFV1_PRESENT_PICTURE_STRUCTURE    = 1 << 3,
+};
+
+enum AVLarixFFV1SuppliedFieldOrder {
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_UNKNOWN     = 0,
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_PROGRESSIVE = 1,
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_TT          = 2,
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_BB          = 3,
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_TB          = 4,
+    AV_LARIX_FFV1_SUPPLIED_FIELD_ORDER_BT          = 5,
+};
+
+enum AVLarixMPEG4PresentationPath {
+    AV_LARIX_MPEG4_PATH_ORDINARY = 1,
+    AV_LARIX_MPEG4_PATH_STUDIO   = 2,
+};
+
+enum AVLarixMPEG4PresentationPresent {
+    AV_LARIX_MPEG4_PRESENT_VOS_PROFILE                 = 1 << 0,
+    AV_LARIX_MPEG4_PRESENT_VOS_LEVEL                   = 1 << 1,
+    AV_LARIX_MPEG4_PRESENT_VOL_OBJECT_TYPE             = 1 << 2,
+    AV_LARIX_MPEG4_PRESENT_VOL_INTERLACED              = 1 << 3,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_SEQUENCE = 1 << 4,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_PROGRESSIVE_FRAME    = 1 << 5,
+    AV_LARIX_MPEG4_PRESENT_TOP_FIELD_FIRST             = 1 << 6,
+    AV_LARIX_MPEG4_PRESENT_REPEAT_FIRST_FIELD          = 1 << 7,
+    AV_LARIX_MPEG4_PRESENT_VOP_STRUCTURE               = 1 << 8,
+    AV_LARIX_MPEG4_PRESENT_VOP_CODED                   = 1 << 9,
+    AV_LARIX_MPEG4_PRESENT_TIME_INCREMENT_RESOLUTION   = 1 << 10,
+    AV_LARIX_MPEG4_PRESENT_FIXED_VOP_RATE              = 1 << 11,
+    AV_LARIX_MPEG4_PRESENT_FIXED_VOP_TIME_INCREMENT    = 1 << 12,
+    AV_LARIX_MPEG4_PRESENT_MODULO_TIME_BASE             = 1 << 13,
+    AV_LARIX_MPEG4_PRESENT_VOP_TIME_INCREMENT           = 1 << 14,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_FRAME_RATE_CODE       = 1 << 15,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_HIGH        = 1 << 16,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_TIME_CODE_LOW         = 1 << 17,
+    AV_LARIX_MPEG4_PRESENT_STUDIO_TEMPORAL_REFERENCE    = 1 << 18,
+};
+
+typedef struct AVLarixFFV1PresentationV1 {
+    uint32_t present;
+    uint32_t version;
+    uint32_t micro_version;
+    uint32_t supplied_field_order;
+    uint32_t picture_structure;
+    uint32_t reserved[3];
+} AVLarixFFV1PresentationV1;
+
+typedef struct AVLarixMPEG4PresentationV1 {
+    uint32_t present;
+    uint32_t path;
+    uint32_t vos_profile;
+    uint32_t vos_level;
+    uint32_t vol_object_type;
+    uint32_t vol_interlaced;
+    uint32_t studio_progressive_sequence;
+    uint32_t studio_progressive_frame;
+    uint32_t top_field_first;
+    uint32_t repeat_first_field;
+    uint32_t vop_structure;
+    uint32_t vop_coded;
+    uint32_t time_increment_resolution;
+    uint32_t fixed_vop_rate;
+    uint32_t fixed_vop_time_increment;
+    uint32_t modulo_time_base;
+    uint32_t vop_time_increment;
+    uint32_t studio_frame_rate_code;
+    uint32_t studio_time_code_high;
+    uint32_t studio_time_code_low;
+    uint32_t studio_temporal_reference;
+    uint32_t reserved[3];
+} AVLarixMPEG4PresentationV1;
+
+typedef struct AVLarixVideoPresentationV1 {
+    uint32_t version;
+    uint32_t byte_size;
+    uint32_t syntax;
+    uint32_t qualifiers;
+    union {
+        AVLarixFFV1PresentationV1 ffv1;
+        AVLarixMPEG4PresentationV1 mpeg4;
+        uint32_t storage[24];
+    } facts;
+} AVLarixVideoPresentationV1;
+
+/**
+ * Copy a validated V1 presentation evidence record into caller-owned storage.
+ *
+ * Input and output storage must not overlap. The output remains unchanged on
+ * every failure.
+ */
+int av_larix_video_presentation_read_v1(
+    const AVFrame *frame,
+    AVLarixVideoPresentationV1 *output,
+    size_t output_size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* AVUTIL_LARIX_VIDEO_PRESENTATION_H */
