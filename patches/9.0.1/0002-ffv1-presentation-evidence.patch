+static int attach_presentation(FFV1Context *f, int software)
+{
+    AVLarixVideoPresentationV1 record = {
+        .version = AV_LARIX_VIDEO_PRESENTATION_VERSION_1,
+        .byte_size = sizeof(record),
+        .syntax = AV_LARIX_VIDEO_PRESENTATION_SYNTAX_FFV1,
+    };
+    AVLarixFFV1PresentationV1 *facts = &record.facts.ffv1;
+    AVFrameSideData *sd;
+    uint8_t covered[MAX_SLICES] = { 0 };
+    int complete = software;
+
+    facts->present = AV_LARIX_FFV1_PRESENT_VERSION;
+    facts->version = f->version;
+    if (f->version > 2) {
+        facts->present |= AV_LARIX_FFV1_PRESENT_MICRO_VERSION;
+        facts->micro_version = f->micro_version;
+    }
+    /* Map explicitly: avutil's public grammar does not import AVFieldOrder. */
+    switch (f->avctx->field_order) {
+    case AV_FIELD_UNKNOWN:     facts->supplied_field_order = 0; break;
+    case AV_FIELD_PROGRESSIVE: facts->supplied_field_order = 1; break;
+    case AV_FIELD_TT:          facts->supplied_field_order = 2; break;
+    case AV_FIELD_BB:          facts->supplied_field_order = 3; break;
+    case AV_FIELD_TB:          facts->supplied_field_order = 4; break;
+    case AV_FIELD_BT:          facts->supplied_field_order = 5; break;
+    default: goto no_context_order;
+    }
+    facts->present |= AV_LARIX_FFV1_PRESENT_SUPPLIED_FIELD_ORDER;
+no_context_order:
+
+    /* Workers own separate observations. Never consult shared predecessor
+     * damage flags here: frame threads may already have taken ownership. */
+    if (software) {
+        for (int i = 0; i < f->slice_count; i++) {
+            const FFV1SliceContext *sc = &f->slices[i];
+            if (!sc->presentation_decoded || sc->slice_damaged) {
+                complete = 0;
+                record.qualifiers |= AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_INCOMPLETE_SYNTAX;
+                if (sc->slice_damaged)
+                    record.qualifiers |= AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_RECOVERED_SYNTAX;
+            }
+            if (f->version <= 2)
+                continue;
+            if (!sc->presentation_header) {
+                complete = 0;
+                continue;
+            }
+            if (sc->presentation_structure != f->slices[0].presentation_structure)
+                complete = 0;
+            for (int y = sc->presentation_sy; y < sc->presentation_sy + sc->presentation_sh; y++) {
+                for (int x = sc->presentation_sx; x < sc->presentation_sx + sc->presentation_sw; x++) {
+                    int cell = y * f->num_h_slices + x;
+                    if (covered[cell])
+                        complete = 0;
+                    covered[cell] = 1;
+                }
+            }
+        }
+    }
+    if (f->version > 2) {
+        for (int i = 0; i < f->num_h_slices * f->num_v_slices; i++)
+            if (!covered[i])
+                complete = 0;
+        if (complete) {
+            facts->present |= AV_LARIX_FFV1_PRESENT_PICTURE_STRUCTURE;
+            facts->picture_structure = f->slices[0].presentation_structure;
+        } else {
+            record.qualifiers |= AV_LARIX_VIDEO_PRESENTATION_QUALIFIER_INCOMPLETE_SYNTAX;
+        }
+    }
+
+    sd = av_frame_new_side_data(f->picture.f, AV_FRAME_DATA_LARIX_VIDEO_PRESENTATION,
+                                sizeof(record));
+    if (!sd)
+        return AVERROR(ENOMEM);
+    memcpy(sd->data, &record, sizeof(record));
+    return 0;
+}
