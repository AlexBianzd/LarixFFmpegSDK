# Keep authored text deterministic across Windows, macOS, and Linux.
* text=auto eol=lf

# Windows command scripts require CRLF for broad cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Source, build, packaging, and metadata files use LF on every platform.
*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.cxx text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.inl text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.patch text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ps1 text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ini text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.xml text eol=lf

# Archives, toolchains, libraries, and generated SDK payloads are binary.
*.7z binary !eol
*.a binary !eol
*.bz2 binary !eol
*.dll binary !eol
*.dylib binary !eol
*.exe binary !eol
*.gz binary !eol
*.lib binary !eol
*.pdb binary !eol
*.so binary !eol
*.tar binary !eol
*.wasm binary !eol
*.xz binary !eol
*.zip binary !eol
